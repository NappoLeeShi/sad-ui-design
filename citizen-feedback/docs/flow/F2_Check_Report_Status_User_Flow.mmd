%%{init: {"htmlLabels": false, "flowchart": {"curve": "basis", "nodeSpacing": 35, "rankSpacing": 40, "padding": 8}, "theme": "base", "themeVariables": {"fontSize": "16px", "background": "#FFFFFF"}}}%%
%% Mục đích: Mô tả hành trình người dân tra cứu trạng thái phản ánh bằng mã tham chiếu,
%% phân biệt rõ trường hợp tìm thấy, không tìm thấy và lỗi hệ thống.
flowchart TD
    Start(["Bắt đầu<br/>Người dân muốn tra cứu trạng thái phản ánh"])
    Home["Trang chính<br/>Chọn “Tra cứu phản ánh”"]
    LookupScreen["Trang tra cứu<br/>Ô nhập mã tham chiếu<br/>Hướng dẫn và ví dụ định dạng"]
    EnterCode["Nhập mã tham chiếu"]
    ClickSearch["Chọn “Tra cứu”"]
    InfoOK{"Thông tin hợp lệ?"}
    InputError[/"Hiển thị lỗi tại ô nhập<br/>Giữ thông tin đã nhập"/]
    FixCode["Chỉnh sửa mã tham chiếu"]
    Searching[/"Hiển thị trạng thái: Đang tra cứu…"/]
    SearchResult{"Tra cứu thành công?"}
    SystemError[/"Thông báo: Chưa thể tra cứu<br/>Lỗi hệ thống, vui lòng thử lại"/]
    RetrySystem{"Thử lại?"}
    Found{"Tìm thấy phản ánh?"}
    Result["Kết quả tra cứu<br/>Mã tham chiếu, trạng thái hiện tại<br/>Thời điểm cập nhật nếu có"]
    NotFound[/"Thông báo: Không tìm thấy phản ánh<br/>Gợi ý kiểm tra lại mã tham chiếu"/]
    RetryLookup{"Điều chỉnh và tra cứu lại?"}
    EndFound(["Kết thúc: Người dân xem được trạng thái"])
    EndNotFound(["Kết thúc: Không có kết quả<br/>quay về trang chính"])
    EndHome(["Kết thúc: Quay về trang chính"])

    Start --> Home --> LookupScreen --> EnterCode --> ClickSearch --> InfoOK
    InfoOK -->|"Không hợp lệ"| InputError --> FixCode --> ClickSearch
    InfoOK -->|"Hợp lệ"| Searching --> SearchResult
    SearchResult -->|"Lỗi hệ thống"| SystemError --> RetrySystem
    RetrySystem -->|"Có"| ClickSearch
    RetrySystem -->|"Không"| EndHome
    SearchResult -->|"Thành công"| Found
    Found -->|"Tìm thấy"| Result --> EndFound
    Found -->|"Không tìm thấy"| NotFound --> RetryLookup
    RetryLookup -->|"Có"| FixCode
    RetryLookup -->|"Không"| EndNotFound

