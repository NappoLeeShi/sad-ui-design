    classDef screen fill:#DEEBF7,stroke:#2E75B6,stroke-width:1.5px,color:#1F1F1F;
    classDef action fill:#FFF2CC,stroke:#BF9000,stroke-width:1.5px,color:#1F1F1F;
    classDef feedback fill:#E2F0D9,stroke:#548235,stroke-width:1.5px,color:#1F1F1F;
    classDef error fill:#FCE4D6,stroke:#C00000,stroke-width:1.5px,color:#1F1F1F;
    classDef decision fill:#EDE7F6,stroke:#5E35B1,stroke-width:1.5px,color:#1F1F1F;
    class Start,EndOK,EndBack startEnd;
    class Home,CategoryScreen,LocationScreen,DescribeScreen,ReviewScreen,Success screen;
    class ClickSubmit,PickCategory,PickLocation,ConfirmLocation,EnterInfo,FixData,EditMenu,Submit action;
    class FormError,CategoryError,PermissionError,LocationError,DataError,SubmitError error;
    class Sending feedback;
    class FormOpen,RetryOpen,CategoryOK,UseCurrent,Permission,LocationOK,DataOK,EditChoice,SubmitResult,RetrySubmit decision;
